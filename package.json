{
  "name": "lantransport",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "node scripts/make-icons.mjs && tauri icon assets/icon.png",
    "check": "tsc --noEmit && node scripts/check-css-fallbacks.mjs && cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "preview:ui": "vite --config dev/preview.config.ts",
    "i18n:check": "node scripts/check-i18n.mjs",
    "check:css": "node scripts/check-css-fallbacks.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "26.6.6",
    "@types/qrcode": "^1.5.6",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.0.16"
  },
  "description": "Share files across your local network, from a small cross-platform desktop app",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0"
}
